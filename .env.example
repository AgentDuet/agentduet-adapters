# Copy to .env and fill in. The examples read these; .env is gitignored.

# AgentDuet (from B3) — required for every example.
AGENTDUET_API_KEY=
AGENTDUET_CONNECTOR_UUID=
# Optional: override the WSS host (defaults to production).
# AGENTDUET_BASE_URL=wss://wss-prod.agentduet.com

# Per provider — set only the one you are running.
GEMINI_API_KEY=
XAI_API_KEY=
DASHSCOPE_API_KEY=
# DASHSCOPE_REGION=intl        # or cn
# Nova Sonic uses the standard AWS credential chain.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
